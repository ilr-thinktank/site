---
import { getCollection } from 'astro:content';
import { published, validateSlugs, renderPage, renderEntry, routes } from '../lib/site.mjs';
export async function getStaticPaths() {
  const articles = published(await getCollection('articles'));
  const events = published(await getCollection('events'));
  const raisonnements = published(await getCollection('raisonnements'));
  validateSlugs(articles, events, raisonnements);
  return [
    ...routes.map(slug => ({ params: { slug }, props: { html: renderPage(slug, articles, events, raisonnements) } })),
    ...articles.map(entry => ({ params: { slug: entry.data.slug }, props: { html: renderEntry(entry) } })),
    ...events.map(entry => ({ params: { slug: `evenements/${entry.data.slug}` }, props: { html: renderEntry(entry) } })),
    ...raisonnements.map(entry => ({ params: { slug: `raisonnements/${entry.data.slug}` }, props: { html: renderEntry(entry) } })),
  ];
}
const { html } = Astro.props;
---
<Fragment set:html={html} />
